[gd_resource type="Resource" script_class="SensorSpec" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/sensor_spec.gd" id="1_sensor"]

[resource]
script = ExtResource("1_sensor")
id = "an_apy_10"
display_name = "AN/APY-10 maritime surveillance radar"
kind = "radar"
emits = true
range_surface_nm = 120.0
range_air_nm = 200.0
antenna_height_m = 3.0
