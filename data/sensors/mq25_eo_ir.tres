[ext_resource type="Script" path="res://scripts/data/sensor_spec.gd" id="1_sensor"]

[resource]
script = ExtResource("1_sensor")
id = "mq25_eo_ir"
display_name = "MQ-25 electro-optical / infrared turret"
kind = "radar"
emits = false
range_surface_nm = 18.0
range_air_nm = 10.0
antenna_height_m = 3.0
classify_rate = 1.1
source_status = "PUBLIC: system designation and broad role; see docs/REALISM.md. GAMEPLAY_ESTIMATE: every range, gain and classification figure here is a tuning value, not a performance claim. Passive optics: sees nothing through weather and radiates nothing. Modelled as a short, silent, high-confidence sensor rather than as a radar."
